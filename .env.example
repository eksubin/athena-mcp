# Used by docker-compose (env_file: .env). Copy to .env and fill in from
# your Supabase project's Settings > API page.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
RESUME_STORAGE_DIR=/data/resumes
CORS_ORIGINS=["http://localhost:3000"]

# The browser calls this directly (it's baked into the web build, not
# read at container start) — on a real VPS this needs to be the API's
# actual public URL, e.g. https://api.yourdomain.com, not a Docker-internal
# hostname like http://api:8000.
PUBLIC_API_URL=http://localhost:8000

# The one fixed, correct URL for this deployment — used as the OAuth
# return address instead of trusting whatever's in the browser's address
# bar. Must also be added to Supabase's Authentication > URL Configuration
# > Redirect URLs allowlist (as `<this>/auth/callback` or `<this>/**`), or
# Supabase will silently refuse to honor it. On a real VPS, this is your
# actual domain, e.g. https://athena.yourdomain.com.
PUBLIC_SITE_URL=http://localhost:3000

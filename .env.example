# Used by docker-compose (env_file: .env). Copy to .env and fill in.
#
# This project self-hosts Supabase's db/auth/rest (see docker-compose.yml
# and supabase/) rather than using Supabase Cloud — its free tier
# auto-pauses projects after a week of inactivity, which stops the whole
# app from working until someone notices and manually un-pauses it.

# --- Self-hosted Supabase stack ---
# Generate fresh values for a new deployment — these are shared secrets,
# not something to copy from an example:
#   POSTGRES_PASSWORD: any long random string
#   JWT_SECRET:         any long random string (sign/verify all sessions)
#   ANON_KEY / SERVICE_ROLE_KEY: legacy-format Supabase API keys, i.e.
#     a JWT signed with JWT_SECRET containing {"role": "anon" | "service_role",
#     "iss": "supabase"} — see README for a one-line script to generate them.
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
# Externally-reachable address of the auth service specifically (through
# the gateway, with its /auth/v1 prefix) — GoTrue uses this to build
# absolute URLs (the Google OAuth redirect URI, its own issuer claim).
API_EXTERNAL_URL=http://localhost:8001/auth/v1

# Google Cloud Console > APIs & Services > Credentials > your OAuth client.
# Add API_EXTERNAL_URL above + "/callback" to that client's Authorized
# redirect URIs — e.g. http://localhost:8001/auth/v1/callback locally.
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# --- Backend (api/worker) — talks to the stack above by Docker service name ---
SUPABASE_URL=http://gateway:8001
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
RESUME_STORAGE_DIR=/data/resumes
CORS_ORIGINS=["http://localhost:3000"]

# --- Browser-facing addresses ---
# These get baked into the web build (next.config's output), so they must
# be addresses a browser on the host — not a container on the Docker
# network — can actually reach. On a real VPS, these become your real
# domains, e.g. https://api.yourdomain.com / https://athena.yourdomain.com.
PUBLIC_API_URL=http://localhost:8000
PUBLIC_SUPABASE_URL=http://localhost:8001

# The one fixed, correct URL for this deployment — used as the OAuth
# return address instead of trusting whatever's in the browser's address
# bar. Must also be in GOTRUE_URI_ALLOW_LIST (docker-compose.yml derives
# that from this value already).
PUBLIC_SITE_URL=http://localhost:3000

# Shows an email/password form on /login, so testing doesn't need a real
# Google OAuth round-trip through a browser. docker-compose.prod.yml turns
# this (and the matching GoTrue setting) off unconditionally — leave unset
# there rather than relying on this default.
ENABLE_TEST_LOGIN=true

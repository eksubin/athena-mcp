# NOT for production/VPS use — see docker-compose.override.yml and
# backend/Dockerfile.localdev for the same pattern on the API side. Only
# exists because this dev machine's AV does TLS interception with a
# locally-generated root CA the container doesn't trust by default.
FROM node:22-slim AS deps
WORKDIR /app
COPY .docker-ca/*.crt /usr/local/share/ca-certificates/
# Node (and therefore npm) doesn't consult the OS trust store by default —
# this is the standard Node mechanism for adding to what it does trust, and
# node:22-slim doesn't even ship `update-ca-certificates` to touch that
# store in the first place, so this is the only step needed.
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/avast-root.crt
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-slim AS build
WORKDIR /app
COPY .docker-ca/*.crt /usr/local/share/ca-certificates/
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/avast-root.crt
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ENABLE_TEST_LOGIN
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_ENABLE_TEST_LOGIN=$NEXT_PUBLIC_ENABLE_TEST_LOGIN \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-slim AS runtime
RUN useradd -m athena
WORKDIR /app
COPY .docker-ca/*.crt /usr/local/share/ca-certificates/
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/avast-root.crt
COPY --from=build --chown=athena:athena /app/.next/standalone ./
COPY --from=build --chown=athena:athena /app/.next/static ./.next/static
COPY --from=build --chown=athena:athena /app/public ./public
USER athena
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD node -e "fetch('http://localhost:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]

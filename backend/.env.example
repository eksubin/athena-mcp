# Copy to .env for local (non-docker) runs. In docker-compose, the root
# .env.example is used instead via `env_file`.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
RESUME_STORAGE_DIR=./.data/resumes
CORS_ORIGINS=["http://localhost:3000"]

# Copy to .env for local (non-docker) runs. In docker-compose, the root
# .env.example is used instead via `env_file`.
# These point at the self-hosted Supabase stack's gateway (see root
# docker-compose.yml's db/auth/rest/gateway services) — running the
# backend outside Docker, that's reachable at localhost:8001, same as
# the browser uses.
SUPABASE_URL=http://localhost:8001
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
RESUME_STORAGE_DIR=./.data/resumes
CORS_ORIGINS=["http://localhost:3000"]
